{% macro table(list) %}
    <table class="w-full bg-white border-collapse">
        <thead>
            <tr class="text-slate-800">
                <th scope="col" class="font-bold px-6 text-left border-solid border-slate-200 border-b py-3 min-w-52">Nom</th>
                <th scope="col" class="font-bold px-6 text-left border-solid border-slate-200 border-b py-3">Email</th>
                <th scope="col" class="font-bold px-6 text-left border-solid border-slate-200 border-b py-3">Nombre d'articles</th>
                <th scope="col" class="px-6 border-solid border-slate-200 border-b py-3"></th>
            </tr>
        </thead>

        <tbody>
            {% for item in list.data %}
                {% set author_name = item.firstname ~ " " ~ item.lastname %}
                <tr class="hover:bg-neutral-50 even:bg-blue-50">
                    <td class="bg-transparent border-solid border-slate-200 border-b py-4 px-6 min-w-52 align-middle" data-label="Nom">{{ author_name }}</td>
                    <td class="py-4 px-6 bg-transparent border-solid border-slate-200 border-b shadow-transparent" data-label="Email">{{ item.email }}</td>
                    <td class="py-4 px-6 bg-transparent border-solid border-slate-200 border-b shadow-transparent" data-label="Nombre d'articles">{{ item.nb_articles }}</td>
                    <td class="py-4 px-6 bg-transparent border-solid border-slate-200 border-b-2 @-3xl/main:border-b! shadow-transparent lg:text-right align-middle">
                        <div class="inline-flex gap-6 w-full justify-around">
                            {{ list_actions.edit(path("author_form", { id: item._id })) }}
                            {{ list_actions.delete(base_url ~ "/api/authors/" ~ item._id, author_name) }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center bg-transparent border-solid border-slate-200 border-b py-4 px-6">Pas de contenu pour le moment</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
