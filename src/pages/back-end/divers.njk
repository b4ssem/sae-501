{% extends "layouts/back-end/base.njk" %}

{% set active_menu_item = "divers" %}

{% block title %}Divers{% endblock %}

{% block main %}
    <div class="bg-white rounded-2xl shadow-md pb-6">
        <header class="mb-1 p-6">
            {% include "components/back-end/breadcrumb.njk" %}
            <h2 class="text-4xl">Divers</h2>
            <p class="text-sm">Les champs avec
                <span class="font-bold text-slate-700 after:content-['*'] after:ml-0.5 after:text-red-500"></span>
                sont requis
            </p>
        </header>
        <div class="px-6">
            {% for item in list_errors %}
                <p class="rounded-lg p-3 bg-red-100 text-red-800 border-solid border-x border-y border-red-700 mb-3">{{ item }}</p>
            {% endfor %}
            {% if messages.success %}
                <p class="rounded-lg p-3 bg-green-100 text-green-800 border-solid border-x border-y border-green-700 mb-3" data-flash-message>{{ messages.success }}</p>
            {% endif %}

            <form action="" data-form method="post" enctype="multipart/form-data">
                <fieldset class="mb-6">
                    <legend class="font-bold text-lg mb-2">Journée portes ouvertes</legend>
                    <p class="text-sm text-slate-600 mb-3">Affichée sur la page d'accueil du site BUT.</p>

                    <label class="block mb-4">
                        <span class="font-bold text-slate-700 after:content-['*'] after:ml-0.5 after:text-red-500">Date</span>
                        <input class="block bg-white w-full max-w-xs border border-slate-300 rounded-md py-2 pr-3 shadow-xs focus:outline-hidden focus:border-sky-500 focus:ring-sky-500 focus:ring-1 sm:text-sm" type="date" name="date" value="{{ open_house.date }}"/>
                    </label>

                    <div class="flex gap-4 flex-col sm:flex-row">
                        <label class="block mb-4">
                            <span class="font-bold text-slate-700">Heure de début</span>
                            <input class="block bg-white w-full border border-slate-300 rounded-md py-2 pr-3 shadow-xs focus:outline-hidden focus:border-sky-500 focus:ring-sky-500 focus:ring-1 sm:text-sm" type="time" name="start_time" value="{{ open_house.start_time }}"/>
                        </label>
                        <label class="block mb-4">
                            <span class="font-bold text-slate-700">Heure de fin</span>
                            <input class="block bg-white w-full border border-slate-300 rounded-md py-2 pr-3 shadow-xs focus:outline-hidden focus:border-sky-500 focus:ring-sky-500 focus:ring-1 sm:text-sm" type="time" name="end_time" value="{{ open_house.end_time }}"/>
                        </label>
                    </div>
                </fieldset>

                <div class="flex gap-x-3 gap-y-5 flex-col justify-end sm:flex-row">
                    <button class="px-4 py-2 font-semibold text-sm bg-blue-700 hocus:bg-blue-950 text-white rounded-2xl shadow-xs inline-flex gap-1 items-center justify-center" type="submit">
                        Sauvegarder
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
