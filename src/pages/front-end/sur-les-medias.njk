{% extends "layouts/front-end/base.njk" %}
{% set page = "sur-les-medias" %}

{% block main %}
<section class="flex flex-col gap-2 mb-4 mt-10 w-[680px]">
  <h2 class="text-3xl font-bold lg:col-span-2 mt-6 lg:mt-0">Les actualités et les évènements importants du BUT et de l'IUT CY Paris Université dans les médias</h2>
</section>
<section class="grid grid-cols-1 md:grid-cols-2 font-open-sans text-base gap-10 mb-10">
  <div class="flex flex-col gap-2">
      <p>La nouvelle réforme : le BUT MMI</p>
      <iframe class="w-full aspect-video" src="https://www.youtube.com/embed/oiEbQF7qfBU" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>
  <div class="flex flex-col gap-2">
      <p>Pourquoi étudier à l'IUT CYU ?</p>
      <iframe class="w-full aspect-video" src="https://www.youtube.com/embed/SyjF4h2Zb7Q" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>
  <div class="flex flex-col gap-2">
      <p>Job interview en anglais au département MMI</p>
      <iframe class="w-full aspect-video" src="https://www.youtube.com/embed/t72pdxpNjyc" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>
  <div class="flex flex-col gap-2">
      <p>L'importance de l'IUT dans les études supérieures</p>
      <iframe class="w-full aspect-video" src="https://www.youtube.com/embed/xD4wshE0hEg" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>
</section>
{% endblock %}
