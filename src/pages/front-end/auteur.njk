{% extends "layouts/front-end/base.njk" %}
{% set page = "author_detail" %}

{% block title %}{{ author.firstname }} {{ author.lastname }}
{% endblock %}

{% block main %}
    <section class="flex flex-col sm:flex-row gap-6 items-center sm:items-start my-8">
        <img src="/uploads/{{ author.image }}" alt="" class="w-40 h-40 rounded-full object-cover shrink-0">
        <div class="text-center sm:text-left">
            <h1 class="text-3xl font-bold">{{ author.firstname }} {{ author.lastname }}</h1>
            {% set bio = author.bio | striptags(true) | escape | nl2br %}
            {% if bio | length > 0 %}
                <p class="mt-3 text-slate-700">{{ bio }}</p>
            {% endif %}
        </div>
    </section>

    <h2 class="text-2xl font-bold mt-12 mb-4">Articles de {{ author.firstname }}</h2>

    <ul class="grid sm:grid-cols-2 xl:grid-cols-3 gap-x-3 gap-y-5 mb-12">
        {% for article in author.list_articles %}
            <li>
                <a href="/articles/{{ article._id }}" class="block h-full">
                    <article class="shadow-sm h-full rounded-lg overflow-hidden flex flex-col hocus:shadow-md transition-shadow">
                        <div class="h-[200px] aspect-square">
                            <img class="h-full w-full object-cover" src="{{ 'images/image-placeholder-article.png' if article.image|length == 0 else '/uploads/' ~ article.image }}" loading="lazy" alt="">
                        </div>
                        <section class="p-5 grow">
                            <p class="text-xl font-bold pb-1">{{ article.title }}</p>
                            {% if article.abstract | length > 0 %}
                                <p class="text-sm text-slate-600">{{ article.abstract }}</p>
                            {% endif %}
                        </section>
                    </article>
                </a>
            </li>
        {% else %}
            <li>Aucun article pour le moment</li>
        {% endfor %}
    </ul>
{% endblock %}
